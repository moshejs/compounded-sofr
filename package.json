{
  "name": "compounded-sofr",
  "version": "1.0.0",
  "description": "SOFR / risk-free-rate compounding-in-arrears math — ARRC & ISDA conventions (lookback, observation shift, lockout), the SOFR Index method, and the compounded average. Reproduces the NY Fed's published values. Zero dependencies.",
  "keywords": [
    "sofr",
    "compounded-sofr",
    "compounding-in-arrears",
    "risk-free-rate",
    "rfr",
    "arrc",
    "isda",
    "sofr-index",
    "overnight-index-swap",
    "fixed-income",
    "rates",
    "finance"
  ],
  "homepage": "https://moshemalka.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshejs/compounded-sofr.git"
  },
  "bugs": "https://github.com/moshejs/compounded-sofr/issues",
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
